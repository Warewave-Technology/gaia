# Gaia'nın yazdığı site ({{ gaia_contract }}); elle değiştirilirse bir
# sonraki run geri alır.
server {
    listen {{ listen_port }} default_server;
    listen [::]:{{ listen_port }} default_server;
    server_name {{ server_name }};
    root {{ root }};

    location / {
        try_files $uri $uri/ =404;
    }
}
