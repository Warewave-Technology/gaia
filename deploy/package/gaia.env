# Gaia server (design 13.2); `gaia server --help` lists every flag.
# The service reads this file; it holds no secret in clear: OpenBao's
# AppRole secret_id is a file of its own (or a systemd credential).

# The database, as the gaia_app role (gaia migrate runs as gaia_owner).
GAIA_DSN=postgres://gaia_app@db.example.com:5432/gaia?sslmode=verify-full

# OpenBao, with AppRole.
GAIA_BAO_ADDR=https://bao.example.com:8200
GAIA_BAO_ROLE_ID=
GAIA_BAO_SECRET_ID_FILE=/etc/gaia/bao-secret-id

GAIA_SERVER_ARGS=--listen 0.0.0.0:8080 --repo https://github.com/example/platform.git --repo-credentials bao://kv/platform/git
