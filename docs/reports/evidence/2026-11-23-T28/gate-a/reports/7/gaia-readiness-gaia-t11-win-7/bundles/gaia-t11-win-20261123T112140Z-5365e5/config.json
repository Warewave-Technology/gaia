{
  "vm": "gaia-t11-win",
  "template": "windows-rdp",
  "machine": {
    "arch": "x86_64",
    "firmware": "bios",
    "memory_mib": 4096,
    "vcpus": 2,
    "disk_bus": "virtio",
    "nic_model": "virtio",
    "mac": "00:50:56:3f:b1:01"
  },
  "boot_timeout_s": 300,
  "probe_timeout_s": 120,
  "shutdown_timeout_s": 60,
  "settle_s": 60,
  "checks": [
    {
      "name": "boot",
      "type": "winrm",
      "port": 5985,
      "boot": true
    },
    {
      "name": "rdp",
      "type": "rdp",
      "port": 3389
    }
  ]
}
