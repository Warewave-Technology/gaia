{
  "vm": "gaia-t21-uefi",
  "template": "linux-basic",
  "machine": {
    "arch": "x86_64",
    "firmware": "efi",
    "memory_mib": 1024,
    "vcpus": 2,
    "disk_bus": "virtio",
    "nic_model": "virtio",
    "mac": "00:50:56:3f:a8:03"
  },
  "boot_timeout_s": 300,
  "probe_timeout_s": 120,
  "shutdown_timeout_s": 60,
  "settle_s": 60,
  "checks": [
    {
      "name": "boot",
      "type": "boot_serial",
      "pattern": "(?m)login: *$"
    },
    {
      "name": "ssh",
      "type": "tcp",
      "port": 22
    },
    {
      "name": "health",
      "type": "http",
      "port": 8080,
      "path": "/health",
      "expect_status": 200,
      "expect_body": "ok"
    }
  ]
}
