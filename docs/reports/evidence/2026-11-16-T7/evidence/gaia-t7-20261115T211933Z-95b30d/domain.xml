<domain type='kvm'>
  <name>gaia-verify-95b30d</name>
  <description>Gaia verification sandbox for gaia-t7 (transient)</description>
  <memory unit='MiB'>1024</memory>
  <vcpu>2</vcpu>
  <os><type arch='x86_64' machine='q35'>hvm</type><boot dev='hd'/></os><features><acpi/><apic/></features>
  <cpu mode='host-passthrough'/>
  <on_poweroff>destroy</on_poweroff><on_reboot>restart</on_reboot><on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    
    <disk type='file' device='disk'><driver name='qemu' type='qcow2'/><source file='/var/lib/libvirt/images/gaia-verify-95b30d/overlay.qcow2'/><target dev='vda' bus='virtio'/></disk>
    <interface type='network'><source network='gaia-verify-95b30d'/><mac address='52:54:00:47:a7:01'/><model type='virtio'/><rom enabled='no'/></interface>
    <serial type='file'><source path='/var/log/libvirt/qemu/gaia-verify-95b30d-serial.log'/><target port='0'/></serial>
    <graphics type='vnc'><listen type='none'/></graphics>
    <video><model type='vga'/></video>
  </devices>
</domain>
