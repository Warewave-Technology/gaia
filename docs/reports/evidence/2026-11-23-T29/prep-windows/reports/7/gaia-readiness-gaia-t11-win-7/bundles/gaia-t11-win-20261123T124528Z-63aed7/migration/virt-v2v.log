$ podman --cgroup-manager=cgroupfs run --rm --init --network=none --cgroups=disabled --cap-drop=all --security-opt=no-new-privileges --userns=keep-id --group-add=keep-groups --device=/dev/kvm --volume=/var/lib/gaia-convert/jobs/mc7/in:/in:ro --volume=/var/lib/gaia-convert/jobs/mc7-out:/out --volume=/var/lib/gaia-convert/virtio-win-0.1.302.iso:/virtio-win.iso:ro --env=GAIA_EXCLUDE=smbus sha256:6bbae1e754eb8a70a71d82128588a332c96ec8049bbc76cc5931e4394e05218d bash -c set -euo pipefail
trap 'echo "gaia: error: preparing virtio-win without $GAIA_EXCLUDE failed: $BASH_COMMAND" >&2; exit 66' ERR
tree=/tmp/virtio-win
mkdir "$tree"
guestfish --ro --format=raw -a /virtio-win.iso -m /dev/sda tar-out / - | tar -x -C "$tree"
chmod -R u+w "$tree" # an ISO's files and folders are read-only
: >/out/gaia-excluded.txt
for d in $GAIA_EXCLUDE; do
	found=$(find "$tree" \( -iname "$d" -o -iname "$d.*" \) -print -prune)
	if [ -z "$found" ]; then
		echo "gaia: error: virtio-win has no driver named $d (no folder or file $d or $d.*)" >&2
		exit 64
	fi
	printf '%s\n' "$found" | sed "s|^$tree/||" >>/out/gaia-excluded.txt
	find "$tree" \( -iname "$d" -o -iname "$d.*" \) -prune -exec rm -rf {} +
done
echo "gaia: virtio-win given to virt-v2v without $GAIA_EXCLUDE ($(wc -l </out/gaia-excluded.txt) folders and files left out)"
export VIRTIO_WIN="$tree"
exec "$@"
 exclude virt-v2v -i vmx /in/gaia-t11-win.vmx -o local -os /out -of qcow2 -on gaia-t11-win
