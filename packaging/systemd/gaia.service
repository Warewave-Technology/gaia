# gaia server (ADR-007 §1). Installed by docs/install.md.
# A repository outside /srv/gaia needs its path in ReadWritePaths (systemctl edit gaia).
[Unit]
Description=Gaia backup and recoverability server
Documentation=https://github.com/Warewave-Technology/gaia/blob/main/docs/install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaia
Group=gaia
ExecStart=/usr/local/bin/gaia server run -config /etc/gaia/server.json
Restart=on-failure
RestartSec=5
UMask=0027

# Hardening: the server writes only its data directory and its repositories.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/gaia /srv/gaia
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
